# Database configuration (Defaults to SQLite async, can swap to PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./platform.db

# JWT Auth Secret
SECRET_KEY=supersecretjwtkey_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys (Gemini API preferred)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini  # Options: gemini, openai, mock

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Token (Optional for higher API rate limits on repo sync)
GITHUB_TOKEN=your_github_personal_access_token_here

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
